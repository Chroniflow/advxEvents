{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advx-anecdotes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-24",
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIKES",
        "class_name": "LikeDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LikeDirectory"]
    }
  ]
}
